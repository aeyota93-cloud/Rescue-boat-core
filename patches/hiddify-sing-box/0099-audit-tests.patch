+package monitoring
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestAudit_C1_06_SlowSubscriberReceivesLatestState(t *testing.T) {
+	b := NewBroadcaster[string](context.Background())
+	defer b.Close()
+	subscription := b.Subscribe(1)
+	defer b.Unsubscribe(subscription)
+
+	// Пока подписчик занят предыдущим Send, очередь вмещает один переход.
+	b.Publish("STOPPING")
+	b.Publish("STOPPED")
+	select {
+	case state, ok := <-subscription:
+		if !ok || state != "STOPPED" {
+			t.Fatalf("C1-06: ожидали последнее состояние STOPPED после переполнения, получили %q (канал открыт: %v)", state, ok)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("C1-06: ожидали последнее состояние за 2 с, не получили события")
+	}
+}
