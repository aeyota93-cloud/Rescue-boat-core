@@ -0,0 +1,106 @@
+package monitoring
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/service/pause"
+)
+
+type auditC204LoopLogger struct {
+	log.ContextLogger
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (l *auditC204LoopLogger) Info(args ...any) {
+	if fmt.Sprint(args...) == "outbound monitoring schedule loop started" {
+		l.once.Do(func() {
+			close(l.entered)
+			<-l.release
+		})
+	}
+}
+
+func TestAudit_C2_04_SchedulerSurvivesStopBeforeSelect(t *testing.T) {
+	ctx := pause.WithDefaultManager(context.Background())
+	logger := &auditC204LoopLogger{
+		ContextLogger: log.NewNOPFactory().Logger(),
+		entered:       make(chan struct{}),
+		release:       make(chan struct{}),
+	}
+	var releaseOnce sync.Once
+	release := func() { releaseOnce.Do(func() { close(logger.release) }) }
+	defer release()
+	m, err := NewOutboundMonitoring(ctx, logger, option.MonitoringOptions{})
+	if err != nil {
+		t.Fatalf("C2-04: ожидали создание monitoring, получили %v", err)
+	}
+	defer m.cancel()
+	// Состояние startTimerWorkers непосредственно перед go scheduleLoop().
+	// Запускаем тот же loop с recover, чтобы его паника не оборвала пакет.
+	ticker := time.NewTicker(time.Hour)
+	defer ticker.Stop()
+	m.mainTicker = ticker
+	m.pauseCallback = pause.RegisterTicker(m.pause, ticker, time.Hour, nil)
+	m.workersRunning.Store(true)
+	m.schedulerWG.Add(1)
+	result := make(chan any, 1)
+	go func() {
+		defer func() { result <- recover() }()
+		m.scheduleLoop()
+	}()
+	deadline := time.NewTimer(2 * time.Second)
+	defer deadline.Stop()
+	select {
+	case <-logger.entered:
+	case <-deadline.C:
+		t.Fatal("C2-04: ожидали вход планировщика за 2 с, получили зависание")
+	}
+	// Тот же порядок возможен при Close сразу после Touch. Барьер делает
+	// проверку nil-паники детерминированной, detector гонок здесь не нужен.
+	m.stopTimerWorkers()
+	m.cancel()
+	release()
+	select {
+	case p := <-result:
+		if p != nil {
+			t.Fatalf("C2-04: ожидали выход планировщика после остановки ticker без паники, получили %v", p)
+		}
+	case <-deadline.C:
+		t.Fatal("C2-04: ожидали завершение остановленного планировщика за 2 с, получили зависание")
+	}
+}
+
+func TestAudit_C2_04_TouchDoesNotRestartClosedMonitor(t *testing.T) {
+	ctx := pause.WithDefaultManager(context.Background())
+	m, err := NewOutboundMonitoring(ctx, log.NewNOPFactory().Logger(), option.MonitoringOptions{})
+	if err != nil {
+		t.Fatalf("C2-04: ожидали создание monitoring, получили %v", err)
+	}
+	// Для Touch важен результат PostStart; сетевые workers здесь не нужны.
+	m.started = true
+	if err := m.Close(); err != nil {
+		t.Fatalf("C2-04: ожидали закрытие monitoring, получили %v", err)
+	}
+	m.Touch()
+	restarted := m.workersRunning.Load()
+	done := make(chan struct{})
+	go func() { m.schedulerWG.Wait(); close(done) }()
+	select {
+	case <-done:
+		// После завершения loop безопасно убрать созданный ошибочным Touch ticker.
+		m.stopTimerWorkers()
+	case <-time.After(2 * time.Second):
+		t.Fatal("C2-04: ожидали завершение планировщика отменённого monitoring за 2 с, получили зависание")
+	}
+	if restarted {
+		t.Fatal("C2-04: ожидали, что Touch после Close не запустит ticker, получили workersRunning=true")
+	}
+}
