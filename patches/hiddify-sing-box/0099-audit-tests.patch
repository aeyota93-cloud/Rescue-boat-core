+package endpoint
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+)
+
+type auditC108Endpoint struct {
+	adapter.Endpoint
+	closes int
+}
+
+func (*auditC108Endpoint) Type() string { return "audit" }
+func (*auditC108Endpoint) Tag() string  { return "audit-awg" }
+func (e *auditC108Endpoint) Close() error {
+	e.closes++
+	return nil
+}
+
+func TestAudit_C1_08_ManagerClosesUnstartedEndpoint(t *testing.T) {
+	e := new(auditC108Endpoint)
+	registry := NewRegistry()
+	Register[struct{}](registry, "audit", func(context.Context, adapter.Router, log.ContextLogger, string, struct{}) (adapter.Endpoint, error) {
+		return e, nil
+	})
+	logger := log.NewNOPFactory().Logger()
+	m := NewManager(logger, registry)
+	if err := m.Create(context.Background(), nil, logger, e.Tag(), e.Type(), nil); err != nil {
+		t.Fatalf("C1-08: ожидали создание endpoint без запуска, получили %v", err)
+	}
+	// Проверка конфига создаёт endpoint и закрывает менеджер без Start.
+	for i := 0; i < 2; i++ {
+		if err := m.Close(); err != nil {
+			t.Fatalf("C1-08: ожидали закрытие менеджера без ошибки, получили %v", err)
+		}
+	}
+	if e.closes != 1 {
+		t.Fatalf("C1-08: ожидали одно закрытие созданного endpoint до Start, получили %d", e.closes)
+	}
+}
