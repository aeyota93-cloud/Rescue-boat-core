@@ -0,0 +1,106 @@
+package route
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type auditC206Logger struct {
+	log.ContextLogger
+	entries []log.Entry
+}
+
+func (l *auditC206Logger) DebugContext(_ context.Context, args ...any) {
+	l.entries = append(l.entries, log.Entry{Level: log.LevelDebug, Message: fmt.Sprint(args...)})
+}
+
+func (l *auditC206Logger) ErrorContext(_ context.Context, args ...any) {
+	l.entries = append(l.entries, log.Entry{Level: log.LevelError, Message: fmt.Sprint(args...)})
+}
+
+func (l *auditC206Logger) TraceContext(_ context.Context, args ...any) {
+	l.entries = append(l.entries, log.Entry{Level: log.LevelTrace, Message: fmt.Sprint(args...)})
+}
+
+type auditC206Reader struct {
+	err   error
+	reads int
+}
+
+func (r *auditC206Reader) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	r.reads++
+	if r.reads == 1 {
+		_, _ = buffer.Write([]byte("established UDP payload"))
+		return M.ParseSocksaddr("192.0.2.1:443"), nil
+	}
+	return M.Socksaddr{}, r.err
+}
+
+type auditC206Writer struct{ packets int }
+
+func (w *auditC206Writer) WritePacket(buffer *buf.Buffer, _ M.Socksaddr) error {
+	w.packets++
+	buffer.Release()
+	return nil
+}
+
+func TestAudit_C2_06_EstablishedUDPFailureLoggedAtError(t *testing.T) {
+	failure := errors.New("read: connection reset by peer")
+	for _, tc := range []struct {
+		name      string
+		download  bool
+		err       error
+		wantError bool
+	}{
+		{"upload_failure", false, failure, true},
+		{"download_failure", true, failure, true},
+		{"upload_normal_close", false, net.ErrClosed, false},
+		{"download_normal_close", true, net.ErrClosed, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			logger := &auditC206Logger{ContextLogger: log.NewNOPFactory().Logger()}
+			manager := NewConnectionManager(logger)
+			reader := &auditC206Reader{err: tc.err}
+			writer := new(auditC206Writer)
+			var done atomic.Bool
+			closed := 0
+			var closeErr error
+			manager.packetConnectionCopy(context.Background(), reader, writer, tc.download, &done, func(err error) {
+				closed++
+				closeErr = err
+			})
+			if writer.packets != 1 || closed != 1 || !errors.Is(closeErr, tc.err) {
+				t.Fatalf("C2-06: ожидали один доставленный UDP-пакет и один callback с причиной %v, получили пакетов=%d, callback=%d, причина=%v", tc.err, writer.packets, closed, closeErr)
+			}
+			direction := "upload"
+			if tc.download {
+				direction = "download"
+			}
+			found := false
+			for _, entry := range logger.entries {
+				if entry.Level == log.LevelError && strings.Contains(entry.Message, "packet "+direction+" closed: ") && strings.Contains(entry.Message, tc.err.Error()) {
+					found = true
+				}
+			}
+			if tc.wantError && !found {
+				t.Fatalf("C2-06: ожидали Error с причиной обрыва установленной UDP-сессии, получили %v", logger.entries)
+			}
+			if !tc.wantError {
+				for _, entry := range logger.entries {
+					if entry.Level == log.LevelError {
+						t.Fatalf("C2-06: ожидали штатное закрытие UDP без Error, получили %v", logger.entries)
+					}
+				}
+			}
+		})
+	}
+}
