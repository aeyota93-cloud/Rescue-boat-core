@@ -0,0 +1,73 @@
+package rule
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+)
+
+// Гонка reloadRules/Match ловится только с -race.
+func TestAudit_C1_03_LocalReloadConcurrentMatch(t *testing.T) {
+	rules := [][]option.HeadlessRule{
+		{{DefaultOptions: option.DefaultHeadlessRule{Domain: []string{"audit.example"}}}},
+		{{DefaultOptions: option.DefaultHeadlessRule{DomainSuffix: []string{"example"}}}},
+	}
+	s := &LocalRuleSet{ctx: context.Background()}
+	if err := s.reloadRules(rules[0]); err != nil {
+		t.Fatalf("C1-03: ожидали загрузку исходного правила, получили %v", err)
+	}
+	start := make(chan struct{})
+	stop := make(chan struct{})
+	defer close(stop)
+	errors := make(chan error, 4)
+	var wg sync.WaitGroup
+	for worker := 0; worker < 4; worker++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			defer func() {
+				if p := recover(); p != nil {
+					errors <- fmt.Errorf("ожидали работу без паники, получили %v", p)
+				}
+			}()
+			<-start
+			for i := 0; i < 1000; i++ {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				if worker == 0 {
+					if err := s.reloadRules(rules[i%len(rules)]); err != nil {
+						errors <- fmt.Errorf("ожидали загрузку валидного правила, получили %v", err)
+						return
+					}
+				} else {
+					// Match меняет кеш metadata: каждый вызов получает свой объект.
+					metadata := &adapter.InboundContext{Domain: "audit.example"}
+					if !s.Match(metadata) {
+						errors <- fmt.Errorf("ожидали совпадение с обоими вариантами правил, получили false")
+						return
+					}
+				}
+			}
+		}(worker)
+	}
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	close(start)
+	select {
+	case <-done:
+		close(errors)
+		for err := range errors {
+			t.Errorf("C1-03: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("C1-03: ожидали завершение reloadRules и Match за 2 с, получили зависание")
+	}
+}
