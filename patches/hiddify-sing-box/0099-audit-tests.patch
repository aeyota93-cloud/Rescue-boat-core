+package awg
+
+import "testing"
+
+type auditC108Tun struct {
+	tunAdapter
+	closes int
+}
+
+func (t *auditC108Tun) Close() error {
+	t.closes++
+	return nil
+}
+
+func TestAudit_C1_08_DeviceClosesTunBeforeStartOnce(t *testing.T) {
+	defer func() {
+		if p := recover(); p != nil {
+			t.Fatalf("C1-08: ожидали закрытие AWG до Start без паники, получили %v", p)
+		}
+	}()
+	tun := new(auditC108Tun)
+	// Состояние после NewDevice: tun уже создан, awgDevice ещё отсутствует.
+	// Подмена tun позволяет проверить владение без настоящего netstack и VPN.
+	d := &Device{tun: tun}
+	for i := 0; i < 2; i++ {
+		if err := d.Close(); err != nil {
+			t.Fatalf("C1-08: ожидали закрытие AWG без ошибки, получили %v", err)
+		}
+	}
+	if tun.closes != 1 {
+		t.Fatalf("C1-08: ожидали одно закрытие tun до Start, получили %d", tun.closes)
+	}
+}
