@@ -0,0 +1,61 @@
+package daemon
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/service"
+)
+
+func TestAudit_C1_09_CanceledFailedServiceClosesFiveObservers(t *testing.T) {
+	ctx, cancel := context.WithCancel(service.ContextWithDefaultRegistry(context.Background()))
+	defer cancel()
+	s := NewStartedService(ServiceOptions{Context: ctx})
+	// Убираем все пять process даже при падении проверки. Закрытие subscriber
+	// через Observer.Close — штатный механизм завершения observable.
+	defer s.serviceStatusObserver.Close()
+	defer s.logObserver.Close()
+	defer s.urlTestObserver.Close()
+	defer s.clashModeObserver.Close()
+	defer s.connectionEventObserver.Close()
+
+	_, statusDone := s.serviceStatusSubscriber.Subscription()
+	_, logDone := s.logSubscriber.Subscription()
+	_, urlTestDone := s.urlTestSubscriber.Subscription()
+	_, clashDone := s.clashModeSubscriber.Subscription()
+	_, connectionDone := s.connectionEventSubscriber.Subscription()
+	observers := []struct {
+		name string
+		done <-chan struct{}
+	}{
+		{"serviceStatus", statusDone},
+		{"log", logDone},
+		{"urlTest", urlTestDone},
+		{"clashMode", clashDone},
+		{"connectionEvent", connectionDone},
+	}
+	// Ошибка разбора возникает до Box.New: ни сеть, ни платформа не нужны.
+	if err := s.StartOrReloadService("{", nil); err == nil {
+		t.Fatal("C1-09: ожидали ошибку запуска с неверным JSON, получили nil")
+	}
+	// Это окончательное завершение владельца, а не CloseService для reload.
+	cancel()
+	deadline := time.NewTimer(2 * time.Second)
+	defer deadline.Stop()
+	for i, observer := range observers {
+		select {
+		case <-observer.done:
+		case <-deadline.C:
+			// Один общий срок для всех пяти, без пяти последовательных ожиданий.
+			for _, remaining := range observers[i:] {
+				select {
+				case <-remaining.done:
+				default:
+					t.Errorf("C1-09: ожидали закрытие Observer %s после ошибки запуска и отмены владельца за 2 с, получили открытый subscriber", remaining.name)
+				}
+			}
+			return
+		}
+	}
+}
diff --git a/route/audit_c2_06_test.go b/route/audit_c2_06_test.go
