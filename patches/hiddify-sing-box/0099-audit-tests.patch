+++ b/common/urltest/audit_c2_05_test.go
@@ -0,0 +1,112 @@
+package urltest
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"testing"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type auditC205Dialer struct{ conn net.Conn }
+
+func (d auditC205Dialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return d.conn, nil
+}
+
+func (auditC205Dialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("C2-05: неожиданный ListenPacket")
+}
+
+func TestAudit_C2_05_UnifiedSecondRequestHonorsContext(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	// Предохранитель для обеих горутин, в том числе при регрессии HTTP Transport.
+	deadline := time.Now().Add(3 * time.Second)
+	_ = client.SetDeadline(deadline)
+	_ = server.SetDeadline(deadline)
+	secondRequest := make(chan error, 1)
+	serverDone := make(chan struct{})
+	go func() {
+		defer close(serverDone)
+		reader := bufio.NewReader(server)
+		for i := 0; i < 2; i++ {
+			req, err := http.ReadRequest(reader)
+			if err != nil {
+				secondRequest <- fmt.Errorf("чтение HEAD %d: %w", i+1, err)
+				return
+			}
+			req.Body.Close()
+			if req.Method != http.MethodHead {
+				secondRequest <- fmt.Errorf("ожидали HEAD, получили %s", req.Method)
+				return
+			}
+			if i == 0 {
+				if _, err := io.WriteString(server, "HTTP/1.1 204 No Content\r\n\r\n"); err != nil {
+					secondRequest <- err
+					return
+				}
+			} else {
+				secondRequest <- nil
+				// Второй HEAD оставляем без ответа. Read завершается при cleanup
+				// либо когда HTTP Transport закроет pipe по контексту запроса.
+				var b [1]byte
+				_, _ = server.Read(b[:])
+			}
+		}
+	}()
+	ctx, cancel := context.WithCancel(ContextWithIsUnifiedDelay(context.Background()))
+	defer cancel()
+	result := make(chan error, 1)
+	go func() {
+		_, err := URLTest(ctx, "http://audit.invalid/generate_204", auditC205Dialer{client})
+		result <- err
+	}()
+	guard := time.NewTimer(2 * time.Second)
+	defer guard.Stop()
+	select {
+	case err := <-secondRequest:
+		if err != nil {
+			t.Fatalf("C2-05: ожидали два HEAD через net.Pipe, получили %v", err)
+		}
+	case <-guard.C:
+		t.Fatal("C2-05: ожидали второй HEAD за 2 с, получили зависание")
+	}
+	// Отмена строго после входа второго запроса: первая проверка ctx уже пройдена.
+	cancel()
+	returned := false
+	var resultErr error
+	select {
+	case resultErr = <-result:
+		returned = true
+	case <-time.After(100 * time.Millisecond):
+	}
+	// Освобождаем обе горутины до сообщения о сбое, сохраняя исходный результат.
+	client.Close()
+	server.Close()
+	if !returned {
+		select {
+		case <-result:
+		case <-guard.C:
+			t.Fatal("C2-05: ожидали завершение URLTest после закрытия pipe за 2 с, получили зависание")
+		}
+	}
+	select {
+	case <-serverDone:
+	case <-guard.C:
+		t.Fatal("C2-05: ожидали завершение обработчика net.Pipe за 2 с, получили зависание")
+	}
+	if !returned {
+		t.Fatal("C2-05: ожидали завершение второго HEAD за 100 мс после отмены контекста, получили ожидание до принудительного закрытия pipe")
+	}
+	if !errors.Is(resultErr, context.Canceled) {
+		t.Fatalf("C2-05: ожидали context.Canceled от второго HEAD, получили %v", resultErr)
+	}
+}
